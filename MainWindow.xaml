<dx:ThemedWindow
    x:Class="CategorizedDownload.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
    Title="Categorized Download" Height="760" Width="1120"
    MinHeight="640" MinWidth="900" WindowStartupLocation="CenterScreen"
    Icon="Assets/CategorizedDownload.ico">
    <Grid Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="26,22,26,16" Background="White" CornerRadius="10" Padding="22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="Download URL" FontSize="12" FontWeight="SemiBold" Foreground="#49536A" Margin="2,0,0,7"/>
                    <dxe:TextEdit x:Name="UrlEditor" Height="40" NullText="Paste an https:// link here" FontSize="14" KeyDown="UrlEditor_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,20,1">
                    <TextBlock Text="Sort into folders" FontSize="12" FontWeight="SemiBold" Foreground="#49536A" Margin="0,0,0,7"/>
                    <dxe:ToggleSwitch x:Name="CategorizeToggle" IsChecked="True" CheckedStateContent="Auto categorize" UncheckedStateContent="Direct" Height="40"/>
                </StackPanel>
                <dx:SimpleButton Grid.Column="2" x:Name="DownloadButton" Content="Download" Width="122" Height="40" VerticalAlignment="Bottom" Click="DownloadButton_Click"/>
                <dx:SimpleButton Grid.Column="3" x:Name="IncomingDownloadsButton" Content="Stop incoming" Width="124" Height="40" Margin="8,0,0,0"
                                 VerticalAlignment="Bottom" Click="IncomingDownloadsButton_Click"/>
            </Grid>
        </Border>

        <Border x:Name="CategoryBuilderPanel" Grid.Row="1" Margin="26,0,26,16" Background="White"
                CornerRadius="10" Padding="20" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Category builder" FontSize="17" FontWeight="SemiBold" Foreground="#202A44"/>
                        <TextBlock Text="Custom templates override the built-in file categories." Margin="0,3,0,0" Foreground="#6B7488"/>
                    </StackPanel>
                    <dx:SimpleButton Content="Close" Padding="14,6" HorizontalAlignment="Right" Click="ToggleCategoryBuilderButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,16,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Category folder" FontSize="12" FontWeight="SemiBold" Foreground="#49536A" Margin="2,0,0,7"/>
                        <dxe:TextEdit x:Name="CategoryNameEditor" Height="36" NullText="Design"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="File extensions" FontSize="12" FontWeight="SemiBold" Foreground="#49536A" Margin="2,0,0,7"/>
                        <dxe:TextEdit x:Name="CategoryExtensionsEditor" Height="36" NullText=".psd, .ai, .fig"/>
                    </StackPanel>
                    <dx:SimpleButton Grid.Column="2" Content="Add / update" Height="36" Padding="16,0" Margin="0,22,8,0" Click="SaveCategoryButton_Click"/>
                    <dx:SimpleButton Grid.Column="3" Content="Delete selected" Height="36" Padding="16,0" Margin="0,22,0,0" Click="DeleteCategoryButton_Click"/>
                </Grid>

                <dxg:GridControl Grid.Row="2" ItemsSource="{Binding CategoryRules}" SelectedItem="{Binding SelectedCategoryRule, Mode=TwoWay}">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Category" Header="Category folder" Width="1*"/>
                        <dxg:GridColumn FieldName="ExtensionsText" Header="Extensions" Width="2*"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView ShowGroupPanel="False" ShowIndicator="False" AllowEditing="False" AutoWidth="True" RowMinHeight="32"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="26,0,26,16" Background="White" CornerRadius="10" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="20,16,14,12">
                    <TextBlock Text="Latest downloads" FontSize="17" FontWeight="SemiBold" Foreground="#202A44" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <dxg:GridSearchControl View="{Binding ElementName=DownloadsView}" Width="250" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <dx:SimpleButton Content="Category builder" Padding="14,6" Margin="0,0,8,0" Click="ToggleCategoryBuilderButton_Click"/>
                        <dx:SimpleButton Content="Open folder" Padding="14,6" Margin="0,0,8,0" Click="OpenFolderButton_Click"/>
                        <dx:SimpleButton Content="Clear log" Padding="14,6" Click="ClearLogButton_Click"/>
                    </StackPanel>
                </Grid>
                <dxg:GridControl Grid.Row="1" x:Name="DownloadsGrid" ItemsSource="{Binding Downloads}" SelectedItem="{Binding SelectedDownload, Mode=TwoWay}"
                                 SelectedItemChanged="DownloadsGrid_SelectedItemChanged">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="FileName" Header="File name" Width="320"/>
                        <dxg:GridColumn FieldName="Category" Header="Category" Width="130"/>
                        <dxg:GridColumn FieldName="Status" Header="Status" Width="100"/>
                        <dxg:GridColumn FieldName="SizeText" Header="Size" Width="110"/>
                        <dxg:GridColumn FieldName="DownloadedAtText" Header="Downloaded" Width="170"/>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="DownloadsView" ShowGroupPanel="False" ShowIndicator="False" AllowEditing="False" AutoWidth="False" RowMinHeight="36" IsRowCellMenuEnabled="True">
                            <dxg:TableView.RowCellMenuCustomizations>
                                <dxb:BarButtonItem Content="Open file" ItemClick="OpenFileContextMenuItem_Click"/>
                                <dxb:BarButtonItem Content="Open containing folder" ItemClick="OpenFolderContextMenuItem_Click"/>
                            </dxg:TableView.RowCellMenuCustomizations>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                </dxg:GridControl>
                <Border x:Name="DownloadDetailsPanel" Grid.Row="2" Margin="20,12,20,16" Padding="14,10" Background="#F7F9FD"
                        BorderBrush="#E3E8F2" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="File" FontSize="11" FontWeight="SemiBold" Foreground="#6B7488"/>
                            <TextBlock x:Name="SelectedFileNameText" FontSize="14" FontWeight="SemiBold" Foreground="#202A44" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Category · size" FontSize="11" FontWeight="SemiBold" Foreground="#6B7488"/>
                            <TextBlock x:Name="SelectedFileSizeText" FontSize="13" Foreground="#202A44" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Saved to" FontSize="11" FontWeight="SemiBold" Foreground="#6B7488"/>
                            <TextBlock x:Name="SelectedDestinationText" FontSize="13" Foreground="#202A44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, ElementName=SelectedDestinationText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="#E4E8F0" BorderThickness="0,1,0,0" Padding="27,12">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="#59647A" VerticalAlignment="Center"/>
                <dxe:ProgressBarEdit x:Name="DownloadProgress" Width="230" Height="8" HorizontalAlignment="Right"
                                     Minimum="0" Maximum="100" ContentDisplayMode="None" ShowBorder="False"
                                     ProgressBrush="#4B73FF" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>
