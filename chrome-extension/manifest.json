{
  "manifest_version": 3,
  "name": "Categorized Download Bridge",
  "version": "0.3.1",
  "description": "Hands Chrome downloads to the Categorized Download desktop app.",
  "key": "",
  "permissions": ["downloads", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:17852/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Categorized Download is active"
  }
}
